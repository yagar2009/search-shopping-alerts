# Google service account JSON with read access to Search Console, GA4 and Merchant Center
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# Optional: Anthropic API key. Without it the pipeline uses the local Claude Code CLI (`claude -p`).
ANTHROPIC_API_KEY=
# Telegram bot and chat for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Google Sheet shared with the service account as Editor (tabs Summary / Alerts / KPIs are created on first run)
SHEET_ID=
